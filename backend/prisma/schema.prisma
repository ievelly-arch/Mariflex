generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model cliente {
  CPF_cliente String @id @db.VarChar(15)
  nome        String @db.VarChar(100)
  email       String @db.VarChar(55)
  telefone    String @db.VarChar(20)
  endereco    String @db.VarChar(100)
}

model empresa {
  idempresa Int    @id @default(autoincrement())
  CNPJ      String @db.VarChar(18)
  telefone  String @db.VarChar(15)
  email     String @db.VarChar(100)
  endereco  String @db.VarChar(150)
}

model funcionario {
  CPF_funcionario      String  @id @db.VarChar(15)
  nome                 String  @db.VarChar(50)
  cargo                String  @db.VarChar(50)
  telefone_funcionario String  @db.VarChar(20)
  email                String  @db.VarChar(100)
  salario              Decimal @db.Decimal(10, 2)
  empresa_idempresa    Int

  @@index([empresa_idempresa], map: "Funcionario_empresa_idempresa_fkey")
}

model itempedido {
  iditempedido       Int     @id @default(autoincrement())
  quantidade         Int
  preco              Decimal @db.Decimal(10, 2)
  pedido_idpedido    Int
  produto_idprodutos Int

  @@index([pedido_idpedido], map: "ItemPedido_pedido_idpedido_fkey")
  @@index([produto_idprodutos], map: "ItemPedido_produto_idprodutos_fkey")
}

model pedido {
  idpedido            Int      @id @default(autoincrement())
  pagamento           String   @db.VarChar(5)
  valor_total         Decimal  @db.Decimal(10, 2)
  data                DateTime @db.Date
  cliente_CPF_cliente String   @db.VarChar(15)
  remetente           String   @db.VarChar(100)
  destinatario        String   @db.VarChar(100)

  @@index([cliente_CPF_cliente], map: "Pedido_cliente_CPF_cliente_fkey")
}

model produto {
  idprodutos        Int     @id @default(autoincrement())
  descricao         String  @db.VarChar(200)
  categoria         String  @db.VarChar(50)
  preco             Decimal @db.Decimal(10, 2)
  empresa_idempresa Int

  @@index([empresa_idempresa], map: "Produto_empresa_idempresa_fkey")
}
